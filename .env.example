# Copy to .env.local and fill in from Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-ANON-KEY

# Public base URL used when generating QR codes / NFC tag payloads.
# In production set this to your real domain, e.g. https://order.sufra.sa
VITE_PUBLIC_BASE_URL=http://localhost:5173

# NEVER put the service_role key in this file. It is a server-only secret and
# anything prefixed VITE_ is bundled into the browser build.
